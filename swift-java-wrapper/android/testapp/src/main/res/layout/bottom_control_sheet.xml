<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/bottom_sheet_background">
    
    <ImageButton
        android:id="@+id/torch_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        android:background="@drawable/control_button_background"
        android:src="@drawable/ic_flash_off"
        android:contentDescription="@string/toggle_torch"
        android:scaleType="centerInside"
        android:padding="12dp" />
    
    <ImageButton
        android:id="@+id/gallery_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        android:background="@drawable/control_button_background"
        android:src="@drawable/ic_gallery"
        android:contentDescription="@string/open_gallery"
        android:scaleType="centerInside"
        android:padding="12dp" />
    
    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        android:background="@drawable/control_button_background"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/open_settings"
        android:scaleType="centerInside"
        android:padding="12dp" />
    
</LinearLayout>
