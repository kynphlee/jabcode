lib/
libs/
!javacpp-wrapper/libs/.gitkeep
# lib/ is ignored, but lib/libjabcode.so is intentionally tracked: the
# panama-wrapper tests load it via -Djava.library.path=../lib, and
# run-integration-tests.sh requires it to pre-exist (it does not run `make`).
!lib/libjabcode.so
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# NOTE: Files already tracked in git history (e.g. javacpp-wrapper/build/*.o,
# javacpp-wrapper/lib*/*.so, top-level *.pdf, prior *.logcat captures) require
# `git rm --cached <path>` in a dedicated hygiene commit. Adding patterns here
# only prevents NEW additions; it does not retroactively untrack.

